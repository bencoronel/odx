{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Admin IPC for the local Odx window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "updater:default",
    "allow-desktop-ready",
    "allow-desktop-set-texts",
    "allow-agent-setup",
    "allow-agent-install",
    "allow-desktop-take-approval",
    "allow-agent-take",
    "allow-table-window-open",
    "allow-window-keep-above",
    "allow-window-keep-above-supported",
    "allow-table-window-take",
    "allow-agent-reply",
    "allow-desktop-restore",
    "allow-desktop-suspend",
    "allow-desktop-cancel-suspend",
    "allow-desktop-flushed",
    "allow-window-present",
    "allow-context-get",
    "allow-context-set",
    "allow-headers-get",
    "allow-headers-set",
    "allow-proxies-get",
    "allow-proxy-save",
    "allow-proxy-delete",
    "allow-proxy-test",
    "allow-tag-colors-get",
    "allow-tag-color-set",
    "allow-proxy-default-set",
    "allow-environment-proxy-get",
    "allow-environment-proxy-set",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-change-password",
    "allow-vault-lock",
    "allow-vault-reset",
    "allow-service-status",
    "allow-mcp-disconnect",
    "allow-activity-list",
    "allow-activity-detail",
    "allow-shell-call",
    "allow-shell-history-list",
    "allow-shell-history-add",
    "allow-shell-history-clear",
    "allow-shell-export",
    "allow-shell-sessions-load",
    "allow-shell-sessions-save",
    "allow-environments-list",
    "allow-environment-save",
    "allow-environment-update",
    "allow-environment-clone",
    "allow-environment-delete",
    "allow-environment-write-mode",
    "allow-environment-check",
    "allow-environment-check-draft",
    "allow-environment-databases",
    "allow-environment-tags-set",
    "allow-environment-favicon-page",
    "allow-environment-favicon-image",
    "allow-environment-open-url",
    "allow-updates-open-releases",
    "allow-clients-list",
    "allow-client-update",
    "allow-approvals-list",
    "allow-approval-decide",
    "allow-rules-list",
    "allow-rule-save",
    "allow-rule-delete",
    "allow-desktop-status",
    "allow-desktop-restart",
    "allow-settings-get",
    "allow-settings-save"
  ]
}
