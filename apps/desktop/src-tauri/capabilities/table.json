{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "table-capability",
  "description": "Window controls and the Terminal reads, exports and window commands a table window uses; no admin access",
  "windows": [
    "table-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-table-window-take",
    "allow-shell-call",
    "allow-shell-export",
    "allow-window-present",
    "allow-window-keep-above",
    "allow-window-keep-above-supported"
  ]
}
