{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odx",
  "version": "0.1.0-alpha.3",
  "identifier": "com.bencoronel.odx",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "enableGTKAppId": true, "windows": [{ "title": "Odx", "width": 1180, "height": 780, "minWidth": 900, "minHeight": 650, "decorations": false, "transparent": true }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "icon": ["icons/icon.png"], "resources": ["icons/icon.png"] }
}
