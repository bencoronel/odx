**/src-tauri/permissions/autogenerated/
*.tsbuildinfo

# Proxy runtime data.
vault.enc
vault.enc.*
*.sock

# SQLCipher database and runtime files.
*.sqlite3
*.sqlite3-*
*.sqlite3.migrating*
