# Local tool state and credentials.
/.aws/
/.codex/
.env
.env.*
!.env.example
*.pem
*.key

# Generated files.
**/node_modules/
**/target/
**/dist/
*.AppImage
# Tauri capability schemas, regenerated on every build.
**/src-tauri/gen/schemas/
